# Salin jadi server/.env lalu isi
# --- Top up via Xendit (daftar gratis di dashboard.xendit.co, pakai key mode TEST dulu) ---
# Buat Secret key dengan izin Money-In = WRITE. Tanpa key ini server jalan mode DEMO.
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxx
# opsional: kalau server punya URL publik (VPS / cloudflared), Xendit bisa kirim webhook
#PUBLIC_URL=https://domainmu.com
#XENDIT_CALLBACK_TOKEN=token_dari_dashboard_xendit
# --- Toko game/pulsa via Digiflazz (digiflazz.com, pakai development key dulu) ---
DIGIFLAZZ_USER=usernamemu
DIGIFLAZZ_KEY=development_key_mu
DIGIFLAZZ_DEV=1      # 1 = testing (tidak benar2 beli), ganti 0 kalau pakai production key
MARKUP=500           # untung per transaksi (Rp)
SHOW_OTP=1           # 0 kalau OTP sudah dikirim lewat SMS/WA gateway
